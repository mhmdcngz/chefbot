# Gemini (tek LLM sağlayıcısı — mock yoktur, anahtar yoksa /chat hata döner)
# Anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ücretsiz katman kotaları (AI Studio'dan kendi hesabınızınkini doğrulayın):
#   gemini-3.5-flash-lite -> 15 RPM / 250K TPM / 500 RPD   <-- varsayılan
#   gemini-3.6-flash      -> 5 RPM  / 250K TPM /  20 RPD   (kaliteli ama günde 20 istek)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Yanıt üst sınırı; düşünme token'ları da buradan harcanır (256-8192)
# LLM_MAX_TOKENS=2048
# none | minimal | low | medium | high
# LLM_REASONING_EFFORT=low

# ChromaDB (APP_* öneki; ortam genelindeki CHROMA_PERSIST_DIR ile çakışmaz)
APP_CHROMA_PERSIST_DIR=./turkish_cuisine_db
APP_CHROMA_COLLECTION_NAME=turkish_cuisine

# Embedding modeli (varsayılan: intfloat/multilingual-e5-small)
# EMBEDDING_MODEL=intfloat/multilingual-e5-small

# RAG varsayılan sonuç sayısı, 1-50 (varsayılan: 5)
# DEFAULT_TOP_K=5

# CORS: virgülle ayrılmış origin listesi veya * (herkese açık)
CORS_ORIGINS=*
